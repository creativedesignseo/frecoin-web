# =============================================================================
# FRECOIN — Configuración Apache para Hostinger
# =============================================================================
# Este archivo se copia automáticamente a dist/.htaccess durante el build de Vite
# (los archivos de public/ se copian tal cual al raíz de dist/).
# =============================================================================

# -----------------------------------------------------------------------------
# Canonicalización de host y protocolo + routing de las páginas prerenderizadas
# -----------------------------------------------------------------------------
# El build genera un HTML real por ruta (scripts/prerender.mjs):
#   dist/index.html, dist/servicios/sai/index.html, dist/sobre-nosotros/index.html…
# Por eso YA NO hay fallback global a index.html: una URL inventada debe dar un
# 404 real (antes toda URL devolvía 200 = soft 404 masivo).
# mod_dir redirige por defecto /servicios/sai → /servicios/sai/ (301 a barra
# final) en cuanto la ruta coincide con un directorio real, y lo hace ANTES de
# que mod_rewrite pueda actuar. Eso duplicaría cada URL respecto al canonical
# (que va sin barra). Con DirectorySlash Off el rewrite de abajo es quien sirve
# el index.html prerenderizado, manteniendo la URL sin barra.
<IfModule mod_dir.c>
  DirectorySlash Off
  DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 www.frecoin.es → frecoin.es (evita host duplicado)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # URL antigua /contacto → ancla de contacto de la home (301 real, ya no
  # dependemos de una redirección de cliente).
  RewriteRule ^contacto/?$ /#contacto [R=301,L,NE]

  # /rediseno es un prototipo interno sin prerender: se sirve la SPA para que
  # React lo pinte. No se indexa (robots.txt Disallow + meta robots noindex +
  # cabecera X-Robots-Tag más abajo).
  RewriteRule ^rediseno/?$ /index.html [L]

  # Ruta con HTML prerenderizado: /servicios/sai → /servicios/sai/index.html
  # Se sirve internamente (sin redirección 301 a barra final), así la URL
  # canónica sigue siendo la que está sin barra.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Archivo o directorio real (assets, sitemap.xml, send-form.php, /admin…)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Sin fallback: cualquier otra cosa cae en el 404 real de Apache,
  # que sirve /404.html (ver ErrorDocument al final del fichero).
</IfModule>

# -----------------------------------------------------------------------------
# Compresión gzip — reduce tamaño de transferencia ~70%
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# -----------------------------------------------------------------------------
# Cache headers — assets versionados se cachean 1 año, HTML nada
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — nunca cachear (revalidar siempre, porque el bundle JS cambia de hash)
  ExpiresByType text/html "access plus 0 seconds"

  # Assets versionados (CSS, JS con hash) — 1 año
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 day"

  # Imágenes — cache 7 días + must-revalidate (no immutable)
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 30 days"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# -----------------------------------------------------------------------------
# Cache-Control para HTML (defensa extra ante el caché del navegador)
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Assets versionados por Vite (JS/CSS con hash en nombre) + fonts → 1 año immutable
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes NO versionadas en filename → 7 días con must-revalidate
  # (el navegador hace HEAD request y si la imagen cambió, descarga la nueva)
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|ico|gif)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>

  # Snapshots de datos del CMS (services/blog/content): cambian al editar desde
  # el panel, así que NO se cachean — el visitante ve los cambios en la siguiente
  # recarga, sin esperar. ETag permite respuestas 304 si no cambió (eficiente).
  <FilesMatch "^(services|blog|content|work-gallery)\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# Seguridad básica
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Refuerzo de noindex para el prototipo interno /rediseno: la cabecera llega
# también a los bots que no ejecutan JavaScript.
<IfModule mod_headers.c>
  # Se evalúa sobre THE_REQUEST (la petición original): REQUEST_URI ya viene
  # reescrito a /index.html cuando mod_headers actúa.
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{THE_REQUEST} =~ m#^\S+\s/rediseno#"
</IfModule>

# Bloquear acceso a archivos sensibles
<FilesMatch "(\.env|\.git|composer\.json|package\.json|package-lock\.json|node_modules)">
  Order allow,deny
  Deny from all
</FilesMatch>

# -----------------------------------------------------------------------------
# 404 real: página propia servida CON estado 404 (no la home con 200).
# El fichero /404.html lo genera el prerender durante el build.
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html
